# Copiá este archivo como .env y completá los valores.
# .env NUNCA se sube al repositorio (está en .gitignore).

# ── FRONTEND (Vite) — prefijo VITE_, viaja al navegador. Nada secreto acá. ──
# mock | real  (antes aceptaba "claude"/"azure" — ya no: el proveedor lo
# decide el servidor, nunca el cliente. Ver IA_PROVEEDOR más abajo.)
VITE_IA_MODO=mock

# Solo si el backend vive en otro dominio. Por defecto usa /api/ia
# VITE_IA_ENDPOINT=/api/ia

# ── SERVER-ONLY — configurar en Netlify → Site settings → Environment ──
# ── variables. NUNCA con prefijo VITE_, NUNCA en el frontend. ──

# Único lugar que decide qué proveedor de IA se usa. El navegador ya no
# puede elegirlo. Valores permitidos: claude | azure
IA_PROVEEDOR=claude

ANTHROPIC_API_KEY=
CLAUDE_MODELO=claude-sonnet-4-6

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ── Netlify Identity ──
# No requiere variables de entorno propias — se configura desde el panel de
# Netlify (Site settings → Identity) y queda atado al sitio automáticamente.
# Las cuentas piloto (docentes invitados de UNITEC y CEUTEC) y el rol
# "docente" en app_metadata.roles se asignan ahí, NUNCA en este archivo ni
# en el código — ver notas de configuración manual entregadas aparte.
