# Copiá este archivo como .env y completá los valores.
# .env NUNCA se sube al repositorio (está en .gitignore).

# mock | claude | azure
VITE_IA_MODO=mock

# Solo si el backend vive en otro dominio. Por defecto usa /api/ia
# VITE_IA_ENDPOINT=/api/ia

# ── Estas NO llevan prefijo VITE_ a propósito: así Vite jamás las mete
# ── en el bundle del navegador. Van en Netlify → Environment variables.
ANTHROPIC_API_KEY=
CLAUDE_MODELO=claude-sonnet-4-6

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
